# =============================================================================
# Local Inference Config — Qwen3.8-27B IQ4_KT/KS on RTX 4070 Ti SUPER
# =============================================================================
# Hardware: RTX 4070 Ti SUPER (16GB VRAM, CUDA 13.1, sm_89)
# Model:    Qwen3.8-27B.i1-IQ4_KT-attn_qkv-IQ4_KS-MTP.gguf (14GB, trellis quants)
#           DENSE model (NOT MoE) — qwen35 architecture
#           Only ik_llama.cpp reads IQ4_KT/KS (ggml types 144/145)
# Engine:   ik_llama.cpp (source-built, see build-ikllama.bat)
#           Alternatives: llama.cpp (upstream), BeeLlama.cpp (KVarN cache)
#           See AGENTS.md#alternative-engines
#
# OPTIMAL CONFIG: 96K context, q4_0 KV, -np 1, --reasoning auto + --jinja
# VERIFIED: 2026-08 — 35.9 tok/s decode at 96K context (pure, ik_llama.cpp)
# =============================================================================

# --- Model ---
# REQUIRED: point at your GGUF. No hardcoded path in the repo.
MODEL_GGUF="G:/Ai/Models/Qwen3.8-27B_qkv-IQ4_KS-MTP/Qwen3.8-27B.i1-IQ4_KT-attn_qkv-IQ4_KS-MTP.gguf"
MODEL_NAME="Qwen3.8-27B.i1-IQ4_KT-attn_qkv-IQ4_KS-MTP.gguf"

# --- Server ---
HOST="127.0.0.1"
PORT="8080"

# --- GPU Offload ---
# 99 = all layers on GPU. Model is dense, no MoE experts to offload.
GPU_LAYERS="99"

# --- Context ---
# 98304 (96K) — optimal tradeoff. 128K drops to ~32 t/s.
CTX_SIZE="98304"

# --- Batch ---
# 1024/256 — ik_llama tuned batch; MTP fits only up to 48K on 16GB.
BATCH_SIZE="1024"
UBATCH_SIZE="256"

# --- Parallel ---
# -np 1 MANDATORY: auto parallel creates 4 slots x 96K KV -> ~3.8 tok/s.
PARALLEL="1"

# --- KV Cache ---
# q4_0 essential for speed (never below q4). ik_llama has NO --kv-unified.
KV_UNIFIED="false"
CACHE_TYPE_K="q4_0"
CACHE_TYPE_V="q4_0"

# --- Threads ---
THREADS="5"

# --- Flash Attention ---
FLASH_ATTN="on"

# --- Reasoning ---
# auto + --jinja required on qwen35; --reasoning off breaks tools requests.
REASONING="auto"
JINJA="true"

# --- Sampling ---
TEMPERATURE="1.0"
MIN_P="0.0"
TOP_P="0.95"
TOP_K="20"

# --- Performance Profile (verified 2026-08) ---
# Context: 96K (98304 tokens), pure mode (no MTP)
# Decode:  ~35.9 tok/s (ik_llama.cpp, q4_0 KV)
# Prefill: ~691 tok/s (313-token prompt)
# VRAM:    CUDA0 buffer constant ~12.78 GB + KV 1.8 GB (96K q4_0) = fits 16GB
# Prompt cache: 26.5s warmup -> 0.86s on repeated agent requests (~30x)
#
# NOTE: --n-cpu-moe is USELESS for this model (dense, not MoE).
# NOTE: MTP speculation (--spec-type mtp:n_max=2) fits only to 48K context.
