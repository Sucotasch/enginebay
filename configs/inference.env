# =============================================================================
# Local Inference Config — Qwen3.6-27B IQ4_XS on RTX 4070 Ti SUPER
# =============================================================================
# Hardware: Intel 12-core, 64GB RAM, RTX 4070 Ti SUPER (16GB VRAM, CUDA 13.2)
# Model:    Qwen3.6-27B.i1-IQ4_XS-attn_qkv-IQ4_XS.gguf (14GB)
#           DENSE model (NOT MoE) — hybrid DeltaNet + GQA attention
#           Only 16 of 64 layers have traditional KV cache (GQA attention layers)
# Engine:   llama.cpp v2.20.1 (CUDA 12, AVX2)
#           Alternative: BeeLlama.cpp (fork) — KVarN cache, precision tail
#           See AGENTS.md#alternative-engines
#
# OPTIMAL CONFIG: 96K context, q4_0 KV (upstream) or kvarn5/kvarn4/tail1024 (Bee), batch 2048
# VERIFIED: 2026-06-28 — 34 tok/s decode at 96K context (upstream)
# =============================================================================

# --- Model ---
MODEL_GGUF="G:/Ai/Models/Qwen3.6-27B.i1-IQ4/Qwen3.6-27B.i1-IQ4_XS-attn_qkv-IQ4_XS.gguf"
MODEL_NAME="Qwen3.6-27B.i1-IQ4_XS-attn_qkv-IQ4_XS.gguf"

# --- Server ---
HOST="127.0.0.1"
PORT="8080"

# --- GPU Offload ---
# 99 = all layers on GPU. Model is dense, no MoE experts to offload.
GPU_LAYERS="99"

# --- Context ---
# 98304 (96K) — optimal tradeoff. 128K drops to 6 tok/s.
CTX_SIZE="98304"

# --- Batch ---
# 2048/512 — faster prefill than 512/256, fits in VRAM.
BATCH_SIZE="2048"
UBATCH_SIZE="512"

# --- Parallel ---
PARALLEL="1"

# --- KV Cache ---
# q4_0 essential for speed. q8_0 at 64K+ kills performance.
# Only 16 layers need KV cache (hybrid DeltaNet architecture).
KV_UNIFIED="true"
CACHE_TYPE_K="q4_0"
CACHE_TYPE_V="q4_0"

# --- Threads ---
THREADS="5"

# --- Flash Attention ---
FLASH_ATTN="on"

# --- Reasoning ---
# Off — fast single-shot responses.
REASONING="off"

# --- Jinja ---
JINJA="true"

# --- Sampling ---
TEMPERATURE="1.0"
MIN_P="0.05"
TOP_P="0.95"
TOP_K="64"
MAX_TOKENS=*** --- Performance Profile (verified 2026-06-28) ---
# Context: 96K (98304 tokens)
# Decode:  ~34 tok/s (5x faster than 128K)
# Prefill: ~58 tok/s
# VRAM:    ~15937 / 16376 MB (127 MB headroom)
#
# KEY FINDING: 128K context causes 5x decode slowdown vs 96K.
# The KV cache at 128K exceeds a critical threshold for memory bandwidth.
# 96K is the sweet spot — 50% more context than 64K, same speed.
#
# NOTE: --n-cpu-moe is USELESS for this model (dense, not MoE).
